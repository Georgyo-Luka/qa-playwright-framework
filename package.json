{
  "name": "qa-playwright-framework",
  "version": "0.1.0",
  "description": "E2E and API test automation framework with Playwright + TypeScript, targeting the ServeRest application.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "author": "Georgyo Luka dos Anjos Maralha",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.6.0"
  }
}
